body {
    font-family trajan-pro, perpetua;

.background-container {
    position: relative;
    height: 100vh; 
    width: 100vw; 
    overflow: hidden; 
}

.background-container::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url("data:image/jpeg;base64,"); /* Replace with your image URL */
    background-size: cover;
    background-position: center;
    filter: blur(8px);
    z-index: -1; 
}

.content-container {
    position: relative; 
    z-index: 1; 
  
    color: white;
    text-align: center;
  padding-top: 20pt;
  }
 
   .floated-img {
  float: left;       
  width: 200pt;      
